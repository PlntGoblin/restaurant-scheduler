# Toast API credentials -- SERVER SIDE ONLY.
#
# Never prefix these with NEXT_PUBLIC_. That prefix inlines a value into the
# browser bundle, which would publish the restaurant's Toast credentials.
#
# Create them in Toast Web: Integrations -> Toast API access -> Manage
# credentials. The secret is shown once, at creation.
#
# Copy this file to .env.local for local development, and set the same four
# values in the Vercel project (Production + Preview).

TOAST_CLIENT_ID=
TOAST_CLIENT_SECRET=

# API hostname, no scheme. e.g. ws-api.toasttab.com
TOAST_HOSTNAME=

# The location's Toast restaurant GUID. Not optional and not inferable: every
# Forefathers location is named "Forefathers Cheesesteaks" in Toast with
# nothing on the list endpoint to tell them apart, so the GUID is the only way
# to say which restaurant you mean.
TOAST_RESTAURANT_GUID=


# ---------------------------------------------------------------------------
# Scheduler sign-in -- SERVER SIDE ONLY.
#
# One shared password for the store's managers, checked on the server. This
# gates every /api/* route except /api/auth/*, which is the only reason the
# routes below can safely exist.
#
# BOTH of these must be set. If either is missing the guarded routes return
# 503 rather than serving employee data -- the gate fails closed on purpose.
# ---------------------------------------------------------------------------

# What managers type on the login screen.
SCHEDULER_PASSWORD=

# HMAC key that signs the session cookie. Any long random string; rotating it
# signs everyone out. Generate one with:
#   openssl rand -hex 32
SCHEDULER_SESSION_SECRET=


# ---------------------------------------------------------------------------
# Toast GUID -> person mapping, read from the My Forefathers database.
# SERVER SIDE ONLY.
#
# Optional. Without it the app still works, but Toast's GUIDs can only be
# resolved by links paired here by hand -- which live in one browser and go
# stale as soon as someone is hired.
#
# This must be the credential for the `scheduler_reader` role created by
# supabase/phase36_scheduler_links.sql in the Forecast86 repo, which can SELECT
# exactly one view of names and GUIDs. Do NOT put the postgres superuser URL
# here: this app's job is to read two columns, not to hold the keys to the
# whole Forefathers database.
#
# Point it at Supabase's TRANSACTION-mode pooler (port 6543) -- serverless
# invocations are short and numerous, and the direct connection runs out.
#
#   postgresql://scheduler_reader.<project-ref>:<password>@<pooler-host>:6543/postgres
# ---------------------------------------------------------------------------
SCHEDULER_LINKS_DB_URL=
