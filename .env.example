# Toast API credentials -- SERVER SIDE ONLY.
#
# Never prefix these with NEXT_PUBLIC_. That prefix inlines a value into the
# browser bundle, which would publish the restaurant's Toast credentials.
#
# Create them in Toast Web: Integrations -> Toast API access -> Manage
# credentials. The secret is shown once, at creation.
#
# Copy this file to .env.local for local development, and set the same four
# values in the Vercel project (Production + Preview).

TOAST_CLIENT_ID=
TOAST_CLIENT_SECRET=

# API hostname, no scheme. e.g. ws-api.toasttab.com
TOAST_HOSTNAME=

# The location's Toast restaurant GUID. Not optional and not inferable: every
# Forefathers location is named "Forefathers Cheesesteaks" in Toast with
# nothing on the list endpoint to tell them apart, so the GUID is the only way
# to say which restaurant you mean.
TOAST_RESTAURANT_GUID=
